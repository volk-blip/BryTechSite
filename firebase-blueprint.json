{
  "entities": {
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted administrator role document keyed by user UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the administrator.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "role": {
          "type": "string",
          "description": "Administrator role designation.",
          "enum": ["super_admin", "admin"],
          "minLength": 5,
          "maxLength": 32
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the admin record was created."
        }
      },
      "required": ["uid", "role", "createdAt"]
    },
    "ClientAccount": {
      "title": "ClientAccount",
      "description": "Client business account metadata without PII (PII and login credentials are isolated in the private subcollection).",
      "type": "object",
      "properties": {
        "ownerUid": {
          "type": "string",
          "description": "Firebase Auth UID of the account owner.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "businessName": {
          "type": "string",
          "description": "Name of the client business.",
          "minLength": 1,
          "maxLength": 120
        },
        "contactName": {
          "type": "string",
          "description": "Display name of the primary contact person.",
          "minLength": 1,
          "maxLength": 100
        },
        "city": {
          "type": "string",
          "description": "City and country of the business.",
          "minLength": 1,
          "maxLength": 80
        },
        "market": {
          "type": "string",
          "description": "Operating market region.",
          "enum": ["Ukraine", "Israel"],
          "minLength": 6,
          "maxLength": 20
        },
        "planName": {
          "type": "string",
          "description": "Name of the subscribed BryTech system bundle.",
          "minLength": 1,
          "maxLength": 160
        },
        "accountStatus": {
          "type": "string",
          "description": "Lifecycle status of the client account.",
          "enum": ["onboarding", "active", "maintenance", "completed"],
          "minLength": 6,
          "maxLength": 20
        },
        "overallProgress": {
          "type": "integer",
          "description": "Aggregated completion percentage across all client products (0-100)."
        },
        "estimatedAgencyCostUsd": {
          "type": "integer",
          "description": "Estimated traditional agency cost in USD."
        },
        "brytechTotalPaidUsd": {
          "type": "integer",
          "description": "Total investment with BryTech in USD."
        },
        "assignedPm": {
          "type": "string",
          "description": "Assigned Kyiv project manager name.",
          "minLength": 1,
          "maxLength": 100
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of account creation."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last account update."
        }
      },
      "required": [
        "ownerUid",
        "businessName",
        "contactName",
        "city",
        "market",
        "planName",
        "accountStatus",
        "overallProgress",
        "estimatedAgencyCostUsd",
        "brytechTotalPaidUsd",
        "assignedPm",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClientPrivateInfo": {
      "title": "ClientPrivateInfo",
      "description": "Isolated PII contact, billing, and admin-provisioned client portal credentials.",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "Parent client document ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Client business email address.",
          "minLength": 3,
          "maxLength": 120
        },
        "phone": {
          "type": "string",
          "description": "Client business phone / Telegram / WhatsApp number.",
          "minLength": 3,
          "maxLength": 60
        },
        "billingAddress": {
          "type": "string",
          "description": "Registered company billing address.",
          "minLength": 1,
          "maxLength": 200
        },
        "loginUsername": {
          "type": "string",
          "description": "Admin-assigned client portal username.",
          "minLength": 2,
          "maxLength": 80
        },
        "loginPassword": {
          "type": "string",
          "description": "Admin-assigned client portal access key.",
          "minLength": 3,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "clientId",
        "ownerUid",
        "email",
        "phone",
        "billingAddress",
        "loginUsername",
        "loginPassword",
        "createdAt",
        "updatedAt"
      ]
    },
    "ClientProduct": {
      "title": "ClientProduct",
      "description": "A digital product or system built by BryTech for a client (Website, CRM, Client Area, or Automation Bot).",
      "type": "object",
      "properties": {
        "clientId": {
          "type": "string",
          "description": "Parent client ID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "ownerUid": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Product name.",
          "minLength": 1,
          "maxLength": 140
        },
        "type": {
          "type": "string",
          "description": "System module category.",
          "enum": ["Website", "CRM", "Client Area", "Automation Bot"],
          "minLength": 3,
          "maxLength": 30
        },
        "domainOrHandle": {
          "type": "string",
          "description": "Production domain or bot handle.",
          "minLength": 1,
          "maxLength": 140
        },
        "progress": {
          "type": "integer",
          "description": "Completion percentage (0-100)."
        },
        "status": {
          "type": "string",
          "description": "Deployment lifecycle state.",
          "enum": ["onboarding", "in_progress", "review", "live", "archived"],
          "minLength": 4,
          "maxLength": 20
        },
        "currentPhase": {
          "type": "string",
          "description": "Current active engineering sprint or phase.",
          "minLength": 1,
          "maxLength": 120
        },
        "leadsOrEventsMonth": {
          "type": "integer",
          "description": "Monthly operational metric count."
        },
        "metricLabel": {
          "type": "string",
          "description": "Label describing the monthly operational metric.",
          "minLength": 1,
          "maxLength": 80
        },
        "maintenanceMode": {
          "type": "boolean",
          "description": "Whether the system is currently in maintenance mode."
        },
        "lastDeploy": {
          "type": "string",
          "description": "Human-readable last deployment label.",
          "minLength": 1,
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "clientId",
        "ownerUid",
        "name",
        "type",
        "domainOrHandle",
        "progress",
        "status",
        "currentPhase",
        "leadsOrEventsMonth",
        "metricLabel",
        "maintenanceMode",
        "lastDeploy",
        "createdAt",
        "updatedAt"
      ]
    },
