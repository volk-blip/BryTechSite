  "firestore": {
    "/admins/{adminUid}": {
      "schema": "AdminRecord",
      "description": "Trusted administrator lookup collection."
    },
    "/clients/{clientId}": {
      "schema": "ClientAccount",
      "description": "Top-level client workspace documents."
    },
    "/clients/{clientId}/private/{infoId}": {
      "schema": "ClientPrivateInfo",
      "description": "Isolated PII contact, billing, and login credentials for a client."
    },
    "/clients/{clientId}/products/{productId}": {
      "schema": "ClientProduct",
      "description": "Products and business systems belonging to a client."
    },
    "/clients/{clientId}/timelines/{timelineId}": {
      "schema": "TimelineMilestone",
      "description": "Project status timeline milestones for a client's products."
    },
    "/clients/{clientId}/documents/{documentId}": {
      "schema": "ClientDocument",
      "description": "Document management records for a client."
    },
    "/clients/{clientId}/tasks/{taskId}": {
      "schema": "ClientTask",
      "description": "Engineering tasks and change requests for a client."
    },
    "/clients/{clientId}/automations/{automationId}": {
      "schema": "ClientAutomation",
      "description": "Automated bot and webhook workflows for a client."
    },
    "/clients/{clientId}/invoices/{invoiceId}": {
      "schema": "ClientInvoice",
      "description": "Milestone invoices for a client."
    },
    "/clients/{clientId}/messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Real-time direct chat messages between a client and the BryTech Admin Panel."
    }
  }
}
